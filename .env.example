DATABASE_URL=postgres://broadcastflow:broadcastflow@localhost:5432/broadcastflow
JWT_SECRET=cambia-esta-clave-de-desarrollo
MFA_KEY=cambia-esta-clave-de-cifrado
WEB_ORIGIN=http://localhost:3000
DONATIONS_WEBHOOK_SECRET=cambia-el-secreto-del-webhook-de-donativos
BILLING_WEBHOOK_SECRET=cambia-el-secreto-del-webhook-de-facturacion
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Solo desarrollo: permite el cobro simulado en POST /public/donations/:id/pay (nunca en producción)
DONATIONS_SIMULATED_PAYMENTS=false
# Anti-spam (Cloudflare Turnstile). Vacíos = captcha desactivado.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Método de pago externo: dominios permitidos para enlaces de pago (coma). Vacío = Mercado Pago, PayPal y Stripe.
PAYMENT_LINK_ALLOWED_DOMAINS=
# URL pública del sitio para canonical, og:url e imagen social por defecto
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo. memory en desarrollo y pruebas. production sin MAIL_TRANSPORT no envía.
# smtp usa STARTTLS contra el relay ya verificado. SMTP_PASSWORD es la clave SMTP
# existente; no va en el repositorio. 250 del relay significa encolado, no entregado.
# WEB_ORIGIN (primer valor) arma los enlaces y en production tiene que ser https.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_FROM=hola@mezkitstudios.com
# SMTP_FROM_NAME=Mezkit Studios
# SMTP_USER=
# SMTP_PASSWORD=
# IP del visitante: solo se lee X-Forwarded-For si el par es loopback,
# está en esta lista (IPs exactas) o presenta el mismo secreto que Caddy.
# No poner rangos amplios. En Docker el par no es loopback: sin secreto,
# todas las visitas comparten la IP del proxy y nadie puede falsificar la cabecera.
# El mismo PROXY_SHARED_SECRET va en el .env del API y en el entorno de Caddy
# (hoy .basic-auth.env). No está elegido aquí.
# TRUSTED_PROXY_IPS=
# PROXY_SHARED_SECRET=
