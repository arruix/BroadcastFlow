{
	admin off
	auto_https disable_redirects
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

http://broadcastflow.mezkitstudios.com {
	redir https://{host}{uri} permanent
}

broadcastflow.mezkitstudios.com {
	tls /certs/origin.pem /certs/origin.key
	# Piloto privado: Cloudflare Access (app "BroadcastFlow piloto") protege el sitio.
	# El origen solo acepta conexiones desde Cloudflare que traigan la cabecera de Access;
	# así nadie se salta Access llegando directo a la IP del VPS.
	@sin_access {
		not {
			remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
			header Cf-Access-Jwt-Assertion *
		}
	}
	encode zstd gzip
	route {
		respond @sin_access "Forbidden" 403 {
			close
		}
		handle /v1/* {
			reverse_proxy 127.0.0.1:3001 {
				# El API solo cree X-Forwarded-For si este secreto coincide.
				# Vacío = no se confía en la cabecera salvo loopback.
				header_up X-BF-Proxy-Token {$PROXY_SHARED_SECRET:}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:3000
		}
	}
}
